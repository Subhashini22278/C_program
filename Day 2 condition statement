// equal and not equal 
#include<stdio.h>
int main()
{
    int a,b;
    scanf("%d%d",&a,&b);
    if(a==b)
    printf("equal");
    else
    printf("not equal");
}
//write a c program to check the give number is postive or negative
//I/p                   o/p 
//12                    Number is 12:positive
//-9                    Number is-9:negative
//0                     Number is 0  
