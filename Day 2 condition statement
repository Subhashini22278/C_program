//greatest of 3
#include<stdio.h>
int main()
{
    int a,b,c;
    scanf("%d%d%d",&a,&b,&c);
    if ((a>b) && (a>c))
    printf("greates num:%d",a);
    else if (b>c)
    printf("greatest num:%d",b);
    else
    printf("greatest num: %d",c);
    

}
